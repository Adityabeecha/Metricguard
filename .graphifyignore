bower_components/
vendor/
.venv/
venv/
env/
envs/
.virtualenv/
.virtualenvs/
site-packages/
__pypackages__/
__pycache__/
.tox/
.nox/
*.egg-info/
*.pyc
*.pyo
*.pyd

# Generated build output and caches
dist/
build/
target/
out/
.next/
.nuxt/
.output/
.svelte-kit/
.angular/
.turbo/
.parcel-cache/
.vite/
.cache/
