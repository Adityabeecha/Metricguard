{
  "description": "Synthetic, analyst-declared concept labels. Ranker sees only names and parsed SQL; concept, variant and ambiguous fields are held-out truth.",
  "period": {"start": "2026-08-01", "end_exclusive": "2026-09-01"},
  "templates": {
    "dev_gross_completed": {"aggregate": "SUM(order_amount)", "filter": "status = 'Completed'", "time_column": "order_date"},
    "dev_booked_open": {"aggregate": "SUM(order_amount)", "filter": "status <> 'Cancelled'", "time_column": "order_date"},
    "dev_paid_net": {"aggregate": "SUM(order_amount - COALESCE(refund_amount, 0))", "filter": "payment_status = 'Paid'", "time_column": "payment_date"},
    "dev_count_completed": {"aggregate": "COUNT(*)", "filter": "status = 'Completed'", "time_column": "order_date"},
    "dev_count_pending": {"aggregate": "COUNT(*)", "filter": "status = 'Pending'", "time_column": "order_date"},
    "dev_count_open": {"aggregate": "COUNT(*)", "filter": "status <> 'Cancelled'", "time_column": "order_date"},
    "dev_customers_completed": {"aggregate": "COUNT(DISTINCT customer_id)", "filter": "status = 'Completed'", "time_column": "order_date"},
    "dev_customers_paid": {"aggregate": "COUNT(DISTINCT customer_id)", "filter": "payment_status = 'Paid'", "time_column": "payment_date"},
    "dev_customers_open": {"aggregate": "COUNT(DISTINCT customer_id)", "filter": "status <> 'Cancelled'", "time_column": "order_date"},
    "hold_refund_completed": {"aggregate": "SUM(COALESCE(refund_amount, 0))", "filter": "status = 'Completed'", "time_column": "order_date"},
    "hold_refund_paid": {"aggregate": "SUM(COALESCE(refund_amount, 0))", "filter": "payment_status = 'Paid'", "time_column": "payment_date"},
    "hold_refund_open": {"aggregate": "SUM(COALESCE(refund_amount, 0))", "filter": "status <> 'Cancelled'", "time_column": "order_date"},
    "hold_pipeline_pending": {"aggregate": "SUM(order_amount * 2)", "filter": "status = 'Pending'", "time_column": "order_date"},
    "hold_pipeline_open": {"aggregate": "SUM(order_amount * 2)", "filter": "status IN ('Pending', 'Completed')", "time_column": "order_date"},
    "hold_pipeline_paid": {"aggregate": "SUM(order_amount * 2)", "filter": "payment_status = 'Paid'", "time_column": "payment_date"},
    "hold_unpaid_count": {"aggregate": "COUNT(*)", "filter": "payment_status = 'Unpaid'", "time_column": "order_date"},
    "hold_pending_count": {"aggregate": "COUNT(*)", "filter": "status = 'Pending'", "time_column": "order_date"},
    "hold_missing_payment_count": {"aggregate": "COUNT(*)", "filter": "status IN ('Pending', 'Cancelled')", "time_column": "order_date"}
  },
  "definitions": [
    {"id": "d01", "split": "development", "concept": "sales_reporting", "variant": "gross_completed", "name": "Dashboard gross sales", "template": "dev_gross_completed"},
    {"id": "d02", "split": "development", "concept": "sales_reporting", "variant": "gross_completed", "name": "Retail completed sales", "template": "dev_gross_completed"},
    {"id": "d03", "split": "development", "concept": "sales_reporting", "variant": "booked_open", "name": "Booked sales total", "template": "dev_booked_open"},
    {"id": "d04", "split": "development", "concept": "sales_reporting", "variant": "unknown", "ambiguous": true, "name": "Revenue unknown policy", "template": "dev_paid_net"},
    {"id": "d05", "split": "development", "concept": "order_volume", "variant": "completed", "name": "Completed order count", "template": "dev_count_completed"},
    {"id": "d06", "split": "development", "concept": "order_volume", "variant": "completed", "name": "Orders fulfilled count", "template": "dev_count_completed"},
    {"id": "d07", "split": "development", "concept": "order_volume", "variant": "pending", "name": "Pending order count", "template": "dev_count_pending"},
    {"id": "d08", "split": "development", "concept": "order_volume", "variant": "unknown", "ambiguous": true, "name": "Order volume draft", "template": "dev_count_open"},
    {"id": "d09", "split": "development", "concept": "customer_reach", "variant": "completed", "name": "Completed customer reach", "template": "dev_customers_completed"},
    {"id": "d10", "split": "development", "concept": "customer_reach", "variant": "completed", "name": "Unique completed buyers", "template": "dev_customers_completed"},
    {"id": "d11", "split": "development", "concept": "customer_reach", "variant": "paid", "name": "Paid customer reach", "template": "dev_customers_paid"},
    {"id": "d12", "split": "development", "concept": "customer_reach", "variant": "unknown", "ambiguous": true, "name": "Active customers draft", "template": "dev_customers_open"},
    {"id": "h01", "split": "holdout", "concept": "refund_liability", "variant": "completed", "name": "Completed refund liability", "template": "hold_refund_completed"},
    {"id": "h02", "split": "holdout", "concept": "refund_liability", "variant": "completed", "name": "Order refund reserve", "template": "hold_refund_completed"},
    {"id": "h03", "split": "holdout", "concept": "refund_liability", "variant": "paid", "name": "Paid refund liability", "template": "hold_refund_paid"},
    {"id": "h04", "split": "holdout", "concept": "refund_liability", "variant": "unknown", "ambiguous": true, "name": "Refunds draft", "template": "hold_refund_open"},
    {"id": "h05", "split": "holdout", "concept": "pending_pipeline", "variant": "pending", "name": "Pending pipeline exposure", "template": "hold_pipeline_pending"},
    {"id": "h06", "split": "holdout", "concept": "pending_pipeline", "variant": "pending", "name": "Awaiting order exposure", "template": "hold_pipeline_pending"},
    {"id": "h07", "split": "holdout", "concept": "pending_pipeline", "variant": "open", "name": "Open pipeline exposure", "template": "hold_pipeline_open"},
    {"id": "h08", "split": "holdout", "concept": "pending_pipeline", "variant": "unknown", "ambiguous": true, "name": "Pipeline value draft", "template": "hold_pipeline_paid"},
    {"id": "h09", "split": "holdout", "concept": "unpaid_workload", "variant": "unpaid", "name": "Unpaid order workload", "template": "hold_unpaid_count"},
    {"id": "h10", "split": "holdout", "concept": "unpaid_workload", "variant": "unpaid", "name": "Orders awaiting payment", "template": "hold_unpaid_count"},
    {"id": "h11", "split": "holdout", "concept": "unpaid_workload", "variant": "pending", "name": "Pending orders workload", "template": "hold_pending_count"},
    {"id": "h12", "split": "holdout", "concept": "unpaid_workload", "variant": "unknown", "ambiguous": true, "name": "Payment backlog draft", "template": "hold_missing_payment_count"}
  ]
}
