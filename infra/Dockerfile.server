# Hosted backend image (Northflank and similar): the API plus its comparison worker in one
# container, with no Docker daemon needed. The website is deployed separately (Vercel).
#   docker build -f infra/Dockerfile.server -t metricguard-server .
# Configuration is environment only; see docs/deployment-plan.md.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt && groupadd -g 10001 app && useradd -u 10001 -g 10001 -M app
COPY packages /app/packages
COPY services /app/services
COPY scripts /app/scripts
COPY MetricGuard_Planning_Pack/examples /app/MetricGuard_Planning_Pack/examples
COPY demo /app/demo
RUN python -m compileall -q /app/packages /app/services \
    && mkdir -p /tmp/metricguard && chown -R 10001:10001 /tmp/metricguard
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    METRICGUARD_MODE=isolated \
    METRICGUARD_RUNNER=local \
    METRICGUARD_DATA_DIR=/tmp/metricguard \
    METRICGUARD_JOB_DIR=/tmp/metricguard/jobs \
    METRICGUARD_ALLOW_UNVERIFIED_LOCAL=false \
    METRICGUARD_SECURE_COOKIES=true \
    METRICGUARD_WORKERS=1 \
    METRICGUARD_RUN_SECONDS=300 \
    METRICGUARD_INGEST_SECONDS=300
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import os,sys,urllib.request; port=os.environ.get('PORT') or os.environ.get('METRICGUARD_PORT') or '8000'; sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{port}/api/v1/health', timeout=4).status == 200 else 1)"
CMD ["python", "-m", "services.serve"]
