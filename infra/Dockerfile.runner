FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt && groupadd -g 10001 runner && useradd -u 10001 -g 10001 -M runner
COPY packages /app/packages
COPY services/supervisor /app/services/supervisor
ENV PYTHONPATH=/app
USER 10001:10001
ENTRYPOINT ["python", "-m", "services.supervisor.runner"]
